# Port exposed by the vpn/gluetun service for the web dashboard.
WEB_PORT=8088

# Gluetun / PrivateVPN credentials. Set real values only in Portainer or a local .env.
VPN_USER=change-me
VPN_PASSWORD=change-me

# Scraper runtime settings.
SCRAPE_INTERVAL_MINUTES=10
ALERT_ON_FIRST_RUN=false
NTFY_URL=

# Cloudflare Tunnel token. This is a secret; do not commit a real value.
CLOUDFLARE_TUNNEL_TOKEN=change-me

# First admin setup token for production. This is a secret; do not commit a real value.
ADMIN_SETUP_TOKEN=change-me
